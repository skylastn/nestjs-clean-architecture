{
  "name": "nestjs-clean-architecture",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "bun@1.4.2",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun --preload dotenv/config ./node_modules/.bin/nest start",
    "start:dev": "bun --preload dotenv/config ./node_modules/.bin/nest start --watch",
    "start:debug": "bun --preload dotenv/config ./node_modules/.bin/nest start --debug --watch",
    "start:prod": "node -r dotenv/config dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "bun test",
    "test:watch": "bun --preload dotenv/config ./node_modules/.bin/jest --watch",
    "test:cov": "bun --preload dotenv/config ./node_modules/.bin/jest --coverage",
    "test:debug": "bun --preload dotenv/config --inspect-brk --preload tsconfig-paths/register --preload ts-node/register ./node_modules/.bin/jest --runInBand",
    "test:e2e": "bun --preload dotenv/config ./node_modules/.bin/jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "seed": "ts-node -r tsconfig-paths/register src/core/seeder/run_seeder.ts",
    "migrate": "bun run typeorm -- migration:run -d src/core/data_source.ts",
    "migrate:revert": "bun run typeorm -- migration:revert -d src/core/data_source.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/typeorm": "^12.0.2",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "js-yaml": "^5.5.0",
    "minio": "^8.0.7",
    "mysql2": "^3.24.6",
    "nestjs-minio": "^2.8.2",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
