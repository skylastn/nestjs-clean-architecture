ENV=local
NODE_ENV=local
TZ=Asia/Jakarta

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=db_automation
DATABASE_USER=root
DATABASE_PASSWORD=test

JWT_SECRET=localSecret

REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
BRUTE_FORCE_ATTEMPT_TTL_SECONDS=900
BRUTE_FORCE_BLOCK_TTL_SECONDS=1800
BRUTE_FORCE_MAX_IP_ATTEMPTS=20
BRUTE_FORCE_MAX_USER_ATTEMPTS=10
BRUTE_FORCE_MAX_COMBO_ATTEMPTS=5

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=nestjs-clean-architecture
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
# Set this to a public bucket base URL when objects are directly viewable.
# MINIO_URL=http://localhost:9000/nestjs-clean-architecture
